SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# --- Base de données ---
# Laisser DB_NAME vide => SQLite (développement rapide)
# Renseigner DB_NAME => MariaDB/MySQL (pip install mysqlclient)
DB_NAME=
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- CORS (app Flutter / web) ---
CORS_ALLOW_ALL_ORIGINS=True

# --- Mobile Money ---
MOBILE_MONEY_GATEWAY=simulated
# True => les paiements sont confirmés immédiatement (tests Flutter). Mettre False en production.
MOBILE_MONEY_AUTO_CONFIRM=True
MOBILE_MONEY_WEBHOOK_SECRET=change-me-webhook-secret

# --- Médias ---
MAX_UPLOAD_MB=500
